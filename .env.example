# Monad
MONAD_RPC_HTTP=https://rpc.monad.xyz
MONAD_RPC_WS=wss://rpc.monad.xyz

# Indexer. The public endpoint rejects at 50/s; stay well under and leave
# headroom for the gateway and treasury sharing the endpoint.
INDEXER_RPC_RPS=20
INDEXER_WINDOW=16
INDEXER_CONFIRMATIONS=2
# INDEXER_START_BLOCK=  # unset = cold start at head

# Storage
DATABASE_URL=postgres://sokoni:sokoni@localhost:5433/sokoni
REDIS_URL=redis://localhost:6380

# ERC-4337. The bundler is a SEPARATE endpoint from the chain RPC: it keeps the
# user-operation mempool and submits bundles to the EntryPoint.
#
# Pimlico by default (ADR 8). Nothing in the code names a provider — the
# JSON-RPC surface is standard, so switching is this one line. Alchemy is the
# configured fallback and also serves Monad chain RPC, if consolidating vendors
# ever looks better than keeping them independent.
#
#   testnet  https://api.pimlico.io/v2/10143/rpc?apikey=YOUR_KEY
#   mainnet  https://api.pimlico.io/v2/143/rpc?apikey=YOUR_KEY
#
# Note the chain id is in the PATH. Pointing a mainnet key at the testnet path
# fails in a way that looks like a signing bug, not a config one.
BUNDLER_RPC_URL=
BUNDLER_RPC_RPS=10

# EntryPoint v0.7, canonical and verified deployed on Monad.
ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Deployed SokoniAccountFactory (see contracts/script/DeployFactory.s.sol).
# Its address is baked into initCode, and therefore into every counterfactual
# account address. Deploy once per network and treat it as permanent: changing
# it moves where every future account lands.
SOKONI_FACTORY=

# Deployed SokoniPaymaster (see contracts/script/DeployPaymaster.s.sol).
# Per-network: the testnet and mainnet deployments are different addresses, and
# an approval signed for one is worthless against the other by construction.
# The backend verifies this address holds the signer below, and refuses to start
# if it does not.
SOKONI_PAYMASTER=

# The key whose approvals that paymaster honours. This key can spend the
# paymaster's EntryPoint deposit, so it belongs in a secret manager, never here
# and never in git. Rotate on-chain with rotateSigner if it leaks.
PAYMASTER_SIGNER_KEY=

# Gateway (backend/cmd/gateway) — the phone's API. Uses the ERC-4337 settings
# above, and refuses to start if the bundler cannot serve ENTRYPOINT or the
# paymaster holds a different signer than PAYMASTER_SIGNER_KEY.
GATEWAY_ADDR=:8080
# The relying party passkeys are bound to. Must match SOKONI_RP_ID in the mobile
# build; the account stores its sha256.
SOKONI_RP_ID=sokoni.app
# The only tokens the paymaster will pay to move, as address:SYMBOL:decimals,
# comma-separated. Required: without an allowlist the paymaster is a free gas
# tap for any call anyone can think of, so the gateway will not start empty.
SPONSORED_TOKENS=
# Snowflake node id for account rows. Distinct per gateway instance.
GATEWAY_NODE_ID=1
# Unset DATABASE_URL and accounts live in memory: fine on a laptop, but a
# restart forgets every registration.

# Option 2 / Mera path (see contracts/script/DeployMeraAccountFactory.s.sol).
# Optional: unset, /v1/mera/* answers "unavailable" instead of the gateway
# refusing to start — same graceful-degradation shape as Markets/DATABASE_URL.
SOKONI_MERA_FACTORY=

# ---- docker-compose.prod.yml only ------------------------------------------
# Local dev's docker-compose.yml hardcodes the Postgres password and never
# reads this; only the VPS deploy's compose file does, to keep a real
# password out of a file that's otherwise safe to commit.
POSTGRES_PASSWORD=
