pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";

import {P256} from "../src/lib/P256.sol";
import {WebAuthn} from "../src/lib/WebAuthn.sol";

/// These run against Monad's execution rules locally, via `network = "monad"`
/// in foundry.toml — no fork and no RPC needed. Plain Foundry has no secp256r1
/// precompile at 0x0100, and forking does not help: a fork copies state, not
/// execution rules. Requires Foundry >= 1.8.
///
/// The vector below is generated by `script/gen_webauthn_vector.py`, which
/// implements P-256 in pure Python so the fixture is reproducible and auditable
/// rather than pasted in from an unverifiable source. It was independently
/// confirmed valid by calling the live precompile at 0x0100 on Monad mainnet.
contract WebAuthnTest is Test {
    uint256 constant PUB_X = 0xfd4d8ec9c2bca971a7c901f7d25b431ec447b8249206d6539ae6f8e7cd9ac1e2;
    uint256 constant PUB_Y = 0xe10a681aba417fd0a31eb462a6dfb8f06a5443a3aa207b0edb95eba1f2bcb60c;

    uint256 constant SIG_R = 0x7da106dca6e3d72fd2556297e7d1a02ff6d5b6d0a3887f54442f0e57fdd8a7af;
    uint256 constant SIG_S = 0x4af1a9d0cc10e5dd63790511595f32f5760809fd9ccb7fd929ff749dc7bc0c47;
    /// N - SIG_S. Verifies just as well; that is the malleability we reject.
    uint256 constant SIG_S_HIGH =
        0xb50e562e33ef1a239c86faeea6a0cd0a46def0b00a4c1eabc9ba562534a7190a;

    bytes32 constant CHALLENGE = 0x1eca235ecd76d3ccc8479e6bbef4346ec18235f7815c2dde47b38367829d3944;
    bytes32 constant DIGEST = 0x73e1a64814a689296cfcf332ed9e120d5162de14299ada479cd81497f047ef53;

    /// sha256("sokoni.app")
    bytes32 constant RP_ID_HASH =
        0x6b4acac5333939cbe4e8b6d4861c3f455146a279a0cec6fa65b45ed8bc305492;

    string constant CLIENT_DATA =
        '{"type":"webauthn.get","challenge":"HsojXs1208zIR55rvvQ0bsGCNfeBXC3eR7ODZ4KdOUQ","origin":"https://sokoni.app","crossOrigin":false}';

    bytes constant AUTH_DATA =
        hex"6b4acac5333939cbe4e8b6d4861c3f455146a279a0cec6fa65b45ed8bc3054920500000000";

    uint256 constant TYPE_INDEX = 1;
    uint256 constant CHALLENGE_INDEX = 23;

    function _auth() internal pure returns (WebAuthn.Auth memory) {
        return WebAuthn.Auth({
            authenticatorData: AUTH_DATA,
            clientDataJSON: CLIENT_DATA,
            challengeIndex: CHALLENGE_INDEX,
            typeIndex: TYPE_INDEX,
            r: SIG_R,
            s: SIG_S
        });
    }

    // ---------------------------------------------------------------- precompile

    function test_PrecompileIsPresentAndVerifiesTheVector() public view {
        assertTrue(P256.verify(DIGEST, SIG_R, SIG_S, PUB_X, PUB_Y), "vector must verify");
    }

    function test_PrecompileRejectsTamperedDigest() public view {
        assertFalse(
            P256.verify(bytes32(uint256(DIGEST) ^ 1), SIG_R, SIG_S, PUB_X, PUB_Y),
            "one flipped bit must invalidate"
        );
    }

    /// The finding that shaped P256.verify: the precompile itself accepts the
    /// high-s form, so the malleability guard has to be ours.
    function test_PrecompileItselfAcceptsHighS() public view {
        assertTrue(
            P256.verifyMalleable(DIGEST, SIG_R, SIG_S_HIGH, PUB_X, PUB_Y),
            "precompile does not enforce low-s"
        );
    }

    function test_VerifyRejectsHighS() public view {
        assertFalse(P256.verify(DIGEST, SIG_R, SIG_S_HIGH, PUB_X, PUB_Y), "must reject high-s");
    }

    function test_NormalizeRoundTrips() public pure {
        assertEq(P256.normalize(SIG_S_HIGH), SIG_S);
        assertEq(P256.normalize(SIG_S), SIG_S);
    }

    function test_RejectsDegenerateScalars() public view {
        assertFalse(P256.verify(DIGEST, 0, SIG_S, PUB_X, PUB_Y), "r=0");
        assertFalse(P256.verify(DIGEST, SIG_R, 0, PUB_X, PUB_Y), "s=0");
        assertFalse(P256.verify(DIGEST, P256.N, SIG_S, PUB_X, PUB_Y), "r>=N");
    }

    // ------------------------------------------------------------------ webauthn

    function test_VerifiesRealAssertion() public view {
        assertTrue(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, _auth(), PUB_X, PUB_Y),
            "real assertion must verify"
        );
    }

    function test_RejectsWrongChallenge() public view {
        bytes memory wrong = abi.encode(bytes32(uint256(CHALLENGE) ^ 1));
        assertFalse(
            WebAuthn.verify(wrong, true, RP_ID_HASH, _auth(), PUB_X, PUB_Y),
            "a different challenge must not verify"
        );
    }

    function test_RejectsWrongPublicKey() public view {
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, _auth(), PUB_X ^ 1, PUB_Y),
            "another credential must not verify"
        );
    }

    function test_RejectsWrongRelyingParty() public view {
        assertFalse(
            WebAuthn.verify(
                abi.encode(CHALLENGE), true, keccak256("other.app"), _auth(), PUB_X, PUB_Y
            ),
            "a credential for another RP must not verify"
        );
    }

    function test_SkipsRpCheckWhenZero() public view {
        assertTrue(
            WebAuthn.verify(abi.encode(CHALLENGE), true, bytes32(0), _auth(), PUB_X, PUB_Y),
            "bytes32(0) must disable the RP check"
        );
    }

    /// A registration assertion must never pass as an authorisation.
    function test_RejectsWebauthnCreateType() public view {
        WebAuthn.Auth memory a = _auth();
        a.clientDataJSON = string.concat(
            '{"type":"webauthn.create","challenge":"HsojXs1208zIR55rvvQ0bsGCNfeBXC3eR7ODZ4KdOUQ",',
            '"origin":"https://sokoni.app","crossOrigin":false}'
        );
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, a, PUB_X, PUB_Y),
            "webauthn.create must be rejected"
        );
    }

    function test_RejectsMissingUserPresence() public view {
        WebAuthn.Auth memory a = _auth();
        bytes memory ad = AUTH_DATA;
        ad[32] = bytes1(uint8(0x04)); // UV set, UP cleared
        a.authenticatorData = ad;
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, a, PUB_X, PUB_Y),
            "user presence is mandatory"
        );
    }

    function test_RejectsMissingUserVerificationWhenRequired() public view {
        WebAuthn.Auth memory a = _auth();
        bytes memory ad = AUTH_DATA;
        ad[32] = bytes1(uint8(0x01)); // UP only
        a.authenticatorData = ad;
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, a, PUB_X, PUB_Y),
            "UV required but absent"
        );
    }

    function test_RejectsShortAuthenticatorData() public view {
        WebAuthn.Auth memory a = _auth();
        a.authenticatorData = hex"6b4acac5";
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, a, PUB_X, PUB_Y),
            "truncated authenticatorData"
        );
    }

    /// Offsets are attacker-supplied. They must never read out of bounds or wrap.
    function testFuzz_ArbitraryOffsetsNeverVerifyOrRevert(uint256 ti, uint256 ci) public view {
        vm.assume(ti != TYPE_INDEX || ci != CHALLENGE_INDEX);
        WebAuthn.Auth memory a = _auth();
        a.typeIndex = ti;
        a.challengeIndex = ci;
        assertFalse(
            WebAuthn.verify(abi.encode(CHALLENGE), true, RP_ID_HASH, a, PUB_X, PUB_Y),
            "bad offsets must fail closed"
        );
    }
}
